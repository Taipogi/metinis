[ext_resource type="Texture2D" uid="uid://fsjbh85di11t" path="res://assets/daggerprojectile.png" id="1_1jb21"]

[sub_resource type="GDScript" id="GDScript_54q3l"]
resource_name = "projectile.gd"
script/source = "extends Area2D

@export var damage := 10
@export var speed := 150.0
@export var lifetime := 3.0

var direction := Vector2.RIGHT
var source: Node = null


func _ready():
	body_entered.connect(_on_body_entered)
	rotation = direction.angle()
	await get_tree().create_timer(lifetime).timeout
	queue_free()


func _physics_process(delta):
	global_position += direction * speed * delta


func _on_body_entered(body):
	if body == source:
		return
	if is_instance_valid(source) and source.is_in_group(\"enemy\") and body.is_in_group(\"enemy\"):
		return

	if body.has_method(\"take_damage\"):
		body.take_damage(damage)
		if is_instance_valid(source) and source.has_method(\"on_hit_dealt\"):
			source.on_hit_dealt(body, damage)
		if body.has_method(\"on_hurt_by\"):
			body.on_hurt_by(source)

	queue_free()


@export var probe_distance := 28.0   
"

