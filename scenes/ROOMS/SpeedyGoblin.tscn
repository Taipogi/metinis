[sub_resource type="GDScript" id="GDScript_07xim"]
resource_name = "speed_goblin_enemy"
script/source = "extends CharacterBody2D

@export var dagger_scene: PackedScene = preload(\"res://scenes/ROOMS/DAGGER.tscn\")
@export var speed := 75
@export var stab_range := 18.0
@export var attack_cooldown := 0.7
@export var windup_time := 0.15
@export var recover_time := 0.15
@export var lunge_speed := 160.0 
@export var lunge_time := 0.10
@export var push_radius := 10.0
@export var push_strength := 35.0

@onready var sprite: AnimatedSprite2D = $AnimatedSprite2D
@onready var detection_area: Area2D = $DetectionArea
@onready var health: Health = $Health

var player: Node2D = null
var can_attack := true
var attacking := false
var lunge_left := 0.0
var lunge_dir := Vector2.ZERO


func _ready():
	add_to_group(\"enemy\")
	detection_area.body_entered.connect(_on_detection_area_body_entered)
	detection_area.body_exited.connect(_on_detection_area_body_exited)
	health.died.connect(_on_died)


func _physics_process(delta):
	if player == null:
		velocity = Vector2.ZERO
		move_and_slide()
		return

	var to_player = player.global_position - global_position
	var dist = to_player.length()

	if attacking:
		if lunge_left > 0.0:
			lunge_left -= delta
			velocity = lunge_dir * lunge_speed + get_soft_push()
		else:
			velocity = get_soft_push() 
		move_and_slide()
		return

	if dist > stab_range * 0.8:
		velocity = to_player.normalized() * speed
	else:
		velocity = Vector2.ZERO
	velocity += get_soft_push()
	velocity = velocity.limit_length(speed * 1.5)
	move_and_slide()

	play_walk_anim(to_player)

	if can_attack and dist <= stab_range:
		stab()


func stab():
	can_attack = false
	attacking = true
	sprite.modulate = Color(1.6, 1.3, 1.3)
	await get_tree().create_timer(windup_time).timeout
	if not is_inside_tree():
		return
	sprite.modulate = Color.WHITE

	if player != null:
		var dir = (player.global_position - global_position).normalized()
		var dagger = dagger_scene.instantiate()
		dagger.source = self
		dagger.direction = dir
		add_child(dagger) 
		lunge_dir = dir
		lunge_left = lunge_time

	await get_tree().create_timer(recover_time).timeout
	attacking = false

	await get_tree().create_timer(attack_cooldown).timeout
	can_attack = true


func get_soft_push() -> Vector2:
	var push := Vector2.ZERO
	var others := get_tree().get_nodes_in_group(\"enemy\")
	if player != null:
		others.append(player)
	for other in others:
		if other == self or not (other is Node2D):
			continue
		var offset : Vector2 = global_position - other.global_position
		var d := offset.length()
		if d >= push_radius:
			continue
		if d < 0.01:
			offset = Vector2.from_angle(randf() * TAU)
			d = 0.01
		push += offset.normalized() * (1.0 - d / push_radius)
	return push * push_strength


func play_walk_anim(direction: Vector2):
	if abs(direction.x) > abs(direction.y):
		sprite.play(\"WALK_RIGHT\" if direction.x > 0 else \"WALK_LEFT\")
	else:
		sprite.play(\"WALK_DOWN\" if direction.y > 0 else \"WALK_UP\")


func take_damage(amount):
	health.take_damage(amount)


func _on_detection_area_body_entered(body):
	if body.is_in_group(\"player\"):
		player = body
		add_collision_exception_with(body)
		body.add_collision_exception_with(self)


func _on_detection_area_body_exited(body):
	if body == player:
		player = null


func _on_died():
	queue_free()
"

